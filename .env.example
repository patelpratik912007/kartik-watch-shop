# ==============================================================================
# Kartik Watch Shop — Environment Configuration Template
# Copy this file to .env and adjust variables as necessary.
# ==============================================================================

# ── 1. Database Configuration (MySQL / XAMPP) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=kartik_watch_shop
# DB_TYPE: "mysql" (default if available) or "sqlite" (automatic fallback)
DB_TYPE=mysql

# ── 2. Flask Application Secrets ──
SECRET_KEY=kartik-watch-shop-secret-horology-mehsana-2026
FLASK_ENV=development
PORT=5000

# ── 3. Google OAuth 2.0 (Google Sign-In) ──
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 4. Razorpay Payment Gateway (Live UPI / Cards / NetBanking) ──
# Get keys from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── 5. Email Notifications (SMTP / Gmail App Password) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── 6. SMS / WhatsApp OTP (Twilio) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── 7. Google Maps Embed API ──
GOOGLE_MAPS_API_KEY=

# ── 8. Cloudinary Image Storage (Optional) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
